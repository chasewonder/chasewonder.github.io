---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="A little about Chase and this blog.">
  <article class="page-section reveal">
    <header class="page-header">
      <h1>About</h1>
      <p>A little about this place.</p>
    </header>
    <div class="prose">
      <p>你好，我是 Chase。</p>
      <p>
        这里用来记录学习、生活和偶尔出现的想法。网站保持简单，希望把更多注意力留给文字本身。
      </p>
      <p>
        你也可以在 <a href="https://github.com/chasewonder">GitHub</a> 找到我。
      </p>
    </div>
  </article>
</BaseLayout>
