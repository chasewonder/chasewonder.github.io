---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, tagPath } from '../../utils/posts';

const posts = await getPublishedPosts();
const counts = new Map<string, number>();

for (const post of posts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}

const tags = [...counts.entries()].sort((a, b) => a[0].localeCompare(b[0], 'zh-CN'));
---

<BaseLayout title="Tags" description="Browse posts by topic.">
  <section class="page-section reveal">
    <header class="page-header">
      <h1>Tags</h1>
      <p>Browse posts by topic.</p>
    </header>
    <ul class="tag-index">
      {
        tags.map(([tag, count]) => (
          <li>
            <a href={tagPath(tag)}>{tag}</a>
            <span>{count}</span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
