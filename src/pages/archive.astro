---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
const grouped = Map.groupBy(posts, (post) => post.data.pubDate.getFullYear());
const years = [...grouped.keys()].sort((a, b) => b - a);
---

<BaseLayout title="Archive" description="All posts, arranged by year.">
  <section class="page-section reveal">
    <header class="page-header">
      <h1>Archive</h1>
      <p>All posts, arranged by year.</p>
    </header>
    <div class="archive-list">
      {
        years.map((year) => (
          <section class="archive-year">
            <h2>{year}</h2>
            <ul>
              {grouped.get(year)?.map((post) => (
                <li>
                  <a href={`/posts/${post.id}`}>{post.data.title}</a>
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>
