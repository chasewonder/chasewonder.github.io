---
interface Props {
  name: 'archive' | 'tags' | 'about' | 'github' | 'theme' | 'rss';
}

const { name } = Astro.props;
---

{
  name === 'archive' && (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 7h16v13H4zM3 3h18v4H3zm5 8h8" />
    </svg>
  )
}
{
  name === 'tags' && (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3 5v6.6L12.4 21 21 12.4 11.6 3H5a2 2 0 0 0-2 2Z" />
      <circle cx="7.5" cy="7.5" r="1.25" />
    </svg>
  )
}
{
  name === 'about' && (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
