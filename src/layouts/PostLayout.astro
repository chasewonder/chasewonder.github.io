---
import BaseLayout from './BaseLayout.astro';
import { formatDate, tagPath, type BlogPost } from '../utils/posts';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="article reveal">
    <header class="article-header">
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      <div class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        {
          post.data.tags.length > 0 && (
            <>
              <span class="post-meta-divider" aria-hidden="true">—</span>
              <div class="post-tags">
                {post.data.tags.map((tag) => <a href={tagPath(tag)}>{tag}</a>)}
              </div>
            </>
          )
        }
      </div>
    </header>
    <div class="prose">
      <slot />
    </div>
    <a class="back-link" href="/">← Back home</a>
  </article>
</BaseLayout>
